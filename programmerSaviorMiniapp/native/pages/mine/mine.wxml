<view class="page">
  <view class="profile">
    <view class="avatar">A</view>
    <view class="profile-info">
      <text class="profile-name">{{name}}</text>
      <text class="profile-sub">管理员 · {{mockMode ? 'Mock 数据' : '真实数据'}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="row-main">
        <text class="row-title">新评论提醒</text>
        <text class="row-desc">开启后新评论会推送给你（下一步接入）</text>
      </view>
      <switch checked="{{pushEnabled}}" color="#3b82f6" bindchange="onPushChange" />
    </view>
  </view>

  <view class="card">
    <view class="row">
      <text class="row-title">数据来源</text>
      <text class="row-value">{{mockMode ? '本地假数据' : '后端接口'}}</text>
    </view>
    <view class="row">
      <text class="row-title">版本</text>
      <text class="row-value">{{version}}</text>
    </view>
  </view>

  <view class="logout" bindtap="logout">退出登录</view>
</view>

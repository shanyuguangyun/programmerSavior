.profile {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #3b82f6;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 700;
}

.profile-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.row:first-child {
  border-top: none;
  padding-top: 0;
}

.row-main {
  display: flex;
  flex-direction: column;
  margin-right: 20rpx;
}

.row-title {
  font-size: 28rpx;
  color: #1f2937;
}

.row-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.row-value {
  font-size: 26rpx;
  color: #6b7280;
}

.logout {
  margin-top: 40rpx;
  background: #ffffff;
  border-radius: 16rpx;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #ef4444;
}

.stats {
  display: flex;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 16rpx;
}

.stat-card:last-child {
  margin-right: 0;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
}

.stat-num.alert {
  color: #ef4444;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.trend {
  display: flex;
  align-items: flex-end;
}

.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 8rpx;
}

.trend-col:last-child {
  margin-right: 0;
}

.trend-num {
  font-size: 20rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.trend-bar-wrap {
  height: 140rpx;
  display: flex;
  align-items: flex-end;
  width: 100%;
}

.trend-bar {
  width: 100%;
  background: #3b82f6;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  opacity: 0.85;
}

.trend-day {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9aa0a6;
}

.comment {
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.comment:first-of-type {
  border-top: none;
  padding-top: 0;
}

.comment-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.comment-author {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  margin-right: 10rpx;
}

.new-badge {
  font-size: 18rpx;
  color: #ffffff;
  background: #ef4444;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 10rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-left: auto;
}

.comment-content {
  display: block;
  font-size: 26rpx;
  color: #374151;
  line-height: 1.6;
}

.comment-post {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

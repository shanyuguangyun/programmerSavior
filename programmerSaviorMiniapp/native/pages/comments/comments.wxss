.tabs {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tab {
  font-size: 28rpx;
  color: #6b7280;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  margin-right: 16rpx;
}

.tab.active {
  background: #3b82f6;
  color: #ffffff;
  font-weight: 600;
}

.mark-all {
  margin-left: auto;
  font-size: 24rpx;
  color: #3b82f6;
}

.head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eef2ff;
  color: #3b82f6;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  overflow: hidden;
}

.author {
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 10rpx;
}

.new-badge {
  font-size: 18rpx;
  color: #ffffff;
  background: #ef4444;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 10rpx;
}

.time {
  margin-left: auto;
  font-size: 22rpx;
  color: #9aa0a6;
}

.content {
  display: block;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

.post {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.action {
  font-size: 24rpx;
  color: #6b7280;
  padding: 8rpx 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  margin-left: 16rpx;
}

.action-primary {
  color: #ffffff;
  background: #3b82f6;
  border-color: #3b82f6;
}

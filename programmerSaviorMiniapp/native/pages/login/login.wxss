.wrap {
  min-height: 100vh;
  padding: 120rpx 48rpx 0;
  box-sizing: border-box;
  background: #f5f6f8;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.brand-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: #3b82f6;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2937;
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.form {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.btn {
  margin-top: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #3b82f6;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.btn::after {
  border: none;
}

.hint {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa0a6;
}

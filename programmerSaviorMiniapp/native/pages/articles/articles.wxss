.summary {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.summary-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #1f2937;
}

.summary-label {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
}

.head {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #1f2937;
}

.rank {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: #9aa0a6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.rank-1 {
  background: #ef4444;
}

.rank-2 {
  background: #f59e0b;
}

.rank-3 {
  background: #3b82f6;
}

.bar-wrap {
  height: 12rpx;
  background: #f0f1f3;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar {
  height: 100%;
  background: #3b82f6;
  border-radius: 999rpx;
  opacity: 0.85;
}

.meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}
